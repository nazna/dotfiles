[user]
  name = nazna
  email = 14846330+nazna@users.noreply.github.com

[init]

  defaultBranch = main
[core]
  editor = vim
  precomposeunicode = true
  quotepath = false

[column]
  ui = auto

[color]
  ui = auto

[status]
  showUntrackedFiles = all

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[push]
  default = simple
  followTags = true
  autoSetupRemote = true

[pull]
  ff = only

[fetch]
  prune = true
  pruneTags = true

[rebase]
  autoStash = true
  autoSquash = true
  updateRefs = true

[merge]
  conflictStyle = zdiff3

[commit]
  verbose = true

[rerere]
  enabled = true
  autoupdate = true

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
  compactionHeuristic = true

[ghq]
  root = ~/work
